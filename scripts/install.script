#!/usr/bin/env bash
# Dragon Boot Theme Installer for Ubuntu 22.04 (Plymouth, UEFI, GRUB)
set -e
# --- Always use script directory as base ---
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-${(%):-%x}}")" && pwd)"
cd "$SCRIPT_DIR/.."
# --- Remote install logic ---
if [[ ! -f "$0" || "$0" == "bash" || "$0" == "/dev/fd/63" ]]; then
    REMOTE_INSTALL=true
    REPO_DIR="$HOME/dragon-boot"
    echo "🌐 Remote installation detected - will install repository to $REPO_DIR"
    # Dependency check
    sudo apt update
    sudo apt install -y git plymouth plymouth-themes grub2-common
    # Clone or update repo
    if [[ ! -d "$REPO_DIR/.git" ]]; then
        git clone https://github.com/statikfintechllc/dragon-boot.git "$REPO_DIR" || { echo "❌ Git clone failed"; exit 1; }
    else
        echo "🔄 Updating existing repository..."
        cd "$REPO_DIR" && git pull origin master || { echo "❌ Git pull failed"; exit 1; }
    fi
    cd "$REPO_DIR"
fi
echo "[🔧] Installing Dragon Boot Theme for Ubuntu 22.04..."
# 1. Ensure dependencies
sudo apt update
sudo apt install -y plymouth plymouth-themes grub2-common
# 2. Copy frame PNGs and theme files
sudo mkdir -p /usr/share/plymouth/themes/dragon
sudo cp -v frames/frame_*.png /usr/share/plymouth/themes/dragon/
sudo cp -v usr/share/plymouth/dragon/*.plymouth /usr/share/plymouth/themes/dragon/
sudo cp -v usr/share/plymouth/dragon/*.script /usr/share/plymouth/themes/dragon/
# 3. Set theme in plymouthd.conf
sudo mkdir -p /etc/plymouth
sudo cp -v etc/plymouth/plymouthd.conf /etc/plymouth/plymouthd.conf
# 4. Patch /etc/default/grub for splash and graphics
sudo sed -i 's/plymouth\.debug//g' /etc/default/grub || true
sudo sed -i 's/plymouth:debug//g' /etc/default/grub || true
sudo sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=3 fbcon=map:1 gfxpayload=keep video=efifb"/' /etc/default/grub
if ! grep -q "^GRUB_GFXMODE=" /etc/default/grub; then
    echo 'GRUB_GFXMODE=1024x768' | sudo tee -a /etc/default/grub
else
    sudo sed -i 's/^GRUB_GFXMODE=.*/GRUB_GFXMODE=1024x768/' /etc/default/grub
fi
if ! grep -q "^GRUB_GFXPAYLOAD_LINUX=" /etc/default/grub; then
    echo 'GRUB_GFXPAYLOAD_LINUX=keep' | sudo tee -a /etc/default/grub
else
    sudo sed -i 's/^GRUB_GFXPAYLOAD_LINUX=.*/GRUB_GFXPAYLOAD_LINUX=keep/' /etc/default/grub
fi
# 5. Register and set the default Plymouth theme
sudo update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth /usr/share/plymouth/themes/dragon/dragon.plymouth 100
sudo update-alternatives --set default.plymouth /usr/share/plymouth/themes/dragon/dragon.plymouth
# 6. Update GRUB and initramfs
sudo update-grub
sudo update-initramfs -u -v
echo "[✅] Dragon Boot Theme Installed Successfully!"
echo "[🚨] If you still do not see the splash, check your UEFI/BIOS settings:"
echo "      - Disable Secure Boot (it can block unsigned themes)"
echo "      - Set boot mode to UEFI, not Legacy/CSM"
echo "      - Make sure graphics drivers are installed and working"
echo "      - If you see only text, your GPU or framebuffer may not be supported by Plymouth"
echo "[ℹ️] Reboot to see your dragon!"
