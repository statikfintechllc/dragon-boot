// Dragon Boot Animation Script

// Global variables
frame_count = 24;
current_frame = 0;
animation_frames = [];
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

// Progress bar variables
progress = 0;
progress_bar_width = screen_width * 0.8;
progress_bar_height = 4;
progress_bar_x = (screen_width - progress_bar_width) / 2;
progress_bar_y = screen_height * 0.8;

// Initialize background
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

// Utility function to pad numbers with zeros
function Pad(num, size) {
    num_str = num.toString();
    while (num_str.length < size) {
        num_str = "0" + num_str;
    }
    return num_str;
}

// Load all animation frames at startup
function LoadFrames() {
    for (i = 0; i < frame_count; i++) {
        frame_filename = ImageDir + "/frame_" + Pad(i, 3) + ".png";
        animation_frames[i] = Image(frame_filename);
        if (animation_frames[i]) {
            animation_frames[i].SetPosition(
                (screen_width - animation_frames[i].GetWidth()) / 2,
                (screen_height - animation_frames[i].GetHeight()) / 2
            );
        }
    }
}

// Update the animation frame
function UpdateAnimation() {
    // Hide previous frame
    if (animation_frames[current_frame]) {
        animation_frames[current_frame].Hide();
    }
    
    // Show current frame
    current_frame = (current_frame + 1) % frame_count;
    if (animation_frames[current_frame]) {
        animation_frames[current_frame].Show();
    }
}

// Draw progress bar
function DrawProgressBar() {
    // Background bar
    progress_bg = Image.Text("", 0, 0, 0);
    progress_bg = Image.Rectangle(progress_bar_x, progress_bar_y, progress_bar_width, progress_bar_height, 0.2, 0.2, 0.2);
    progress_bg.Show();
    
    // Progress fill
    fill_width = progress_bar_width * progress;
    if (fill_width > 0) {
        progress_fill = Image.Rectangle(progress_bar_x, progress_bar_y, fill_width, progress_bar_height, 0.8, 0.3, 0.1);
        progress_fill.Show();
    }
}

// Handle boot progress updates
function BootProgressCallback(duration, progress_value) {
    progress = progress_value;
    DrawProgressBar();
}

// Handle status updates
function DisplayNormalCallback() {
    UpdateAnimation();
}

// Handle password prompts
function DisplayPasswordCallback(prompt, bullets) {
    // Show password prompt
    if (prompt) {
        prompt_text = Image.Text(prompt, 1, 1, 1);
        prompt_text.SetPosition(screen_width / 2 - prompt_text.GetWidth() / 2, screen_height * 0.7);
        prompt_text.Show();
    }
    
    // Show bullet points for entered characters
    if (bullets) {
        bullet_text = Image.Text(bullets, 1, 1, 1);
        bullet_text.SetPosition(screen_width / 2 - bullet_text.GetWidth() / 2, screen_height * 0.75);
        bullet_text.Show();
    }
}

// Handle messages
function DisplayMessageCallback(text) {
    if (text) {
        message = Image.Text(text, 1, 1, 1);
        message.SetPosition(screen_width / 2 - message.GetWidth() / 2, screen_height * 0.9);
        message.Show();
    }
}

// Initialize the theme
LoadFrames();

// Register callbacks
Plymouth.SetBootProgressFunction(BootProgressCallback);
Plymouth.SetDisplayNormalFunction(DisplayNormalCallback);
Plymouth.SetDisplayPasswordFunction(DisplayPasswordCallback);
Plymouth.SetDisplayMessageFunction(DisplayMessageCallback);

// Start the animation refresh cycle
Plymouth.SetRefreshFunction(function() {
    UpdateAnimation();
});

// Set refresh rate to ~25fps (40ms per frame)
Plymouth.SetRefreshRate(25);
